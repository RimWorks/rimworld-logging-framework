root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
file_header_template = unset

[*.xml]
max_line_length = off

[*.{json,jsonc,yml,yaml,mjs,cjs,js,ts,html,css,md}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_indent_braces = false
csharp_new_line_before_open_brace = all
dotnet_style_prefer_collection_expression = true
dotnet_diagnostic.CA1707.severity = none
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

[Makefile]
indent_style = tab

# Harmony patch classes follow the Type_Method_Patch convention, so the
# PascalCase naming rule is a false positive here. (The unused-member rule
# S1144 is suppressed inline on the Prefix methods, since the scanner ignores
# its editorconfig severity.)
[**/Hijack/VerseLog_*_Patch.cs]
dotnet_diagnostic.S101.severity = none


# The mod ships net472; the test project compiles the same source as net10.0. These rules all
# suggest .NET Core-only APIs (ThrowIfNull, ThrowIfLessThan, Environment.ProcessId,
# StartsWith(char), Contains(char), GeneratedRegex) so they only fire in the test build.
[Source/RimWorks.RimLogging/**.cs]
dotnet_diagnostic.CA1510.severity = none
dotnet_diagnostic.CA1512.severity = none
dotnet_diagnostic.CA1837.severity = none
dotnet_diagnostic.CA1865.severity = none
dotnet_diagnostic.CA2249.severity = none
dotnet_diagnostic.SYSLIB1045.severity = none

# net472/net48 reference assemblies carry no [NotNullWhen] on IsNullOrEmpty and friends, so the
# compiler cannot narrow and every ! S8969 flags here is load-bearing. Removing them is CS8602.
dotnet_diagnostic.S8969.severity = none

# Verse builds Defs from XML and Scribe_Values.Look binds by ref. Both need public fields, so
# turning these into properties breaks def loading and settings save/load.
[**/{ChannelDef,SinkDef,LoggingSettings}.cs]
dotnet_diagnostic.S1104.severity = none

# The instance members are a facade over the process-global LogViewerSession. Marking them
# static would spread LogViewerSession across ~20 viewer call sites for no gain.
[**/LogViewerState.cs]
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.S2325.severity = none

# The compiler finds this type by name, so it has to stay an empty class.
[**/Polyfill/IsExternalInit.cs]
dotnet_diagnostic.S2094.severity = none

# Closed AST hierarchy. An interface would let anything outside Filtering/ implement it.
[**/Filtering/AstNode.cs]
dotnet_diagnostic.S2094.severity = none

# The URL is the shipped default the settings page seeds, not a path the code reads directly.
[**/Settings/LoggingSettingsDefaults.cs]
dotnet_diagnostic.S1075.severity = none

# ClearInSink stays its own static method. Moving it into Scope trips S2696.
[**/Pipeline/ReentryGuard.cs]
dotnet_diagnostic.S3398.severity = none

# reads vanilla's private EditWindow_Log.canAutoOpen so our toggle and its own button stay
# one flag. a mirrored bool would drift the moment either side changed it.
[**/Viewer/LogViewerBoot.cs]
dotnet_diagnostic.S3011.severity = none

# Dialog_ is RimWorld's own convention for Verse.Window subclasses (Dialog_Rename,
# Dialog_MessageBox). Renaming it would break the name every RimWorld modder looks for.
[**/Viewer/Dialog_NameFilterPreset.cs]
dotnet_diagnostic.S101.severity = none

# SonarAnalyzer runs a newer ruleset than the SonarCloud quality profile does, so these fire
# locally and are never reported by CI. Test fixtures have no unmanaged state to dispose, their
# timestamps are fixtures rather than instants, and their empty blocks are deliberate stubs.
[Source/RimWorks.RimLogging.Tests/**.cs]
dotnet_diagnostic.S3881.severity = none
dotnet_diagnostic.S6562.severity = none
dotnet_diagnostic.S108.severity = none
dotnet_diagnostic.S3236.severity = none
dotnet_diagnostic.S3877.severity = none
dotnet_diagnostic.S1144.severity = none

# The static swap is the point: readers take the dictionary without locking, and the lock only
# guards replacing it. Assigning through an instance is what makes the copy-on-write work.
[**/ConcordBackend.cs]
dotnet_diagnostic.S2696.severity = none

# These loops run once per log entry. A Where or Any there allocates a closure and an iterator
# on the hot path to save three lines.
[**/{ModContext,TaggedMessageChannel,HarmonyBackend}.cs]
dotnet_diagnostic.S3267.severity = none

# The comment quotes the broken expression the regression test guards, so it reads as code.
[**/Viewer/ViewerLogSinkTests.cs]
dotnet_diagnostic.S125.severity = none

# TODO(<reason>): <what deletes this> is the house convention for a deliberate shortcut, so a
# TODO here is a recorded decision rather than an unfinished one.
[*.cs]
dotnet_diagnostic.S1135.severity = none

# CA1861 targets an array rebuilt on every call of a hot method. An expected value in an
# assertion runs once, and hoisting it away from the assert is harder to read.
[Source/RimWorks.RimLogging.Tests/**.cs]
dotnet_diagnostic.CA1861.severity = none


<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Directory.Build.props sets TargetFramework; blank it so the multi-target outer build runs. -->
        <TargetFramework></TargetFramework>
        <TargetFrameworks>net472;net48</TargetFrameworks>
        <TargetFrameworks Condition="'$(GameTfm)' == 'net10.0'">net10.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(PackAllTfms)' == 'true'">net472;net48;net10.0</TargetFrameworks>
        <!-- GameTfm is what RimWorld runs, so that build is the one the mod ships. -->
        <OutDir Condition="'$(TargetFramework)' == '$(GameTfm)'">..\..\$(GameVersion)\Assemblies\</OutDir>
        <RootNamespace>RimWorks.RimLogging</RootNamespace>
        <AssemblyName>RimWorks.RimLogging</AssemblyName>
        <Description>Public structured logging framework for RimWorld 1.6+ mods. Core pipeline, channels, sinks, filter DSL, and Verse.Log + Unity hijack.</Description>
        <PackageId>RimWorks.RimLogging</PackageId>
        <PackageTags>rimworld;logging;modding;framework</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DocumentationFile Condition="'$(TargetFramework)' == '$(GameTfm)'">..\..\$(GameVersion)\Assemblies\$(AssemblyName).xml</DocumentationFile>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <!-- the hooks stay internal so they never reach the NuGet API surface -->
        <InternalsVisibleTo Include="RimWorks.RimLogging.Patches.Concord"/>
        <InternalsVisibleTo Include="RimWorks.RimLogging.Patches.Harmony"/>
    </ItemGroup>

    <ItemGroup>
        <!-- net10 has all three in the shared framework, so they only ship on the net472 side -->
        <!-- ships to Assemblies/: Directory.Build.props excludes runtime assets by default -->
        <PackageReference Include="System.Text.Json" Version="10.0.*" ExcludeAssets="" Condition="'$(TargetFramework)' != 'net10.0'"/>
        <!-- net472 counts ValueTuple as framework provided so the SDK skips it, but System.Text.Json binds the real assembly -->
        <PackageReference Include="System.ValueTuple" Version="4.6.*" GeneratePathProperty="true" Condition="'$(TargetFramework)' != 'net10.0'"/>
        <PackageReference Include="Concord.Ref" Version="0.25.*" PrivateAssets="all"/>
        <PackageReference Include="Concord.Analyzers" Version="0.25.*" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.*" PrivateAssets="all" Condition="'$(TargetFramework)' != 'net10.0'">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <Reference Include="$(GamecrateRefs)/*.dll"
                   Exclude="$(GamecrateRefs)/System.*.dll;$(GamecrateRefs)/System.dll;$(GamecrateRefs)/Microsoft.*.dll;$(GamecrateRefs)/mscorlib.dll;$(GamecrateRefs)/netstandard.dll;$(GamecrateRefs)/WindowsBase.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="System.Net.Http" Condition="'$(TargetFramework)' != 'net10.0'"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="Languages/**/*.xml" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <!-- built alongside, but never referenced: the DLL only ships as a package analyzer -->
        <ProjectReference Include="..\RimWorks.RimLogging.Analyzers\RimWorks.RimLogging.Analyzers.csproj"
                          PrivateAssets="all" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\RimWorks.RimLogging.CodeFixes\RimWorks.RimLogging.CodeFixes.csproj"
                          PrivateAssets="all" ReferenceOutputAssembly="false" />
        <!-- pack runs on the outer build, where TargetFramework is empty -->
        <None Include="..\RimWorks.RimLogging.Analyzers\bin\$(Configuration)\netstandard2.0\RimWorks.RimLogging.Analyzers.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"
              Condition="'$(TargetFramework)' == ''" />
        <None Include="..\RimWorks.RimLogging.CodeFixes\bin\$(Configuration)\netstandard2.0\RimWorks.RimLogging.CodeFixes.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"
              Condition="'$(TargetFramework)' == ''" />
    </ItemGroup>

    <Target Name="ShipValueTuple" AfterTargets="Build"
            Condition="'$(TargetFramework)' == 'net472' And '$(PkgSystem_ValueTuple)' != ''">
        <Copy SourceFiles="$(PkgSystem_ValueTuple)/lib/net47/System.ValueTuple.dll"
              DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"/>
    </Target>

    <!-- Inner builds only; the multi-target outer build has no ResolveAssemblyReferences. -->
    <Target Name="CopyRimWorldRuntimeDeps" AfterTargets="Build" DependsOnTargets="ResolveAssemblyReferences" Condition="'$(TargetFramework)' != ''">
        <Copy SourceFiles="@(ReferenceCopyLocalPaths)"
              DestinationFiles="@(ReferenceCopyLocalPaths->'$(OutDir)%(DestinationSubDirectory)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>

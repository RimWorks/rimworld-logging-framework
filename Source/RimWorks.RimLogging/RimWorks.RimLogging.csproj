<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Directory.Build.props sets TargetFramework; blank it so the multi-target outer build runs. -->
        <TargetFramework></TargetFramework>
        <TargetFrameworks>net472;net48</TargetFrameworks>
        <!-- net472 is what RimWorld runs, so that build is the one the mod ships. -->
        <OutDir Condition="'$(TargetFramework)' == 'net472'">..\..\Assemblies\</OutDir>
        <RootNamespace>RimWorks.RimLogging</RootNamespace>
        <AssemblyName>RimWorks.RimLogging</AssemblyName>
        <Description>Public structured logging framework for RimWorld 1.6+ mods. Core pipeline, channels, sinks, filter DSL, and Verse.Log + Unity hijack.</Description>
        <PackageId>RimWorks.RimLogging</PackageId>
        <PackageTags>rimworld;logging;modding;framework</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DocumentationFile Condition="'$(TargetFramework)' == 'net472'">..\..\Assemblies\$(AssemblyName).xml</DocumentationFile>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <!-- the hooks stay internal so they never reach the NuGet API surface -->
        <InternalsVisibleTo Include="RimWorks.RimLogging.Patches.Concord"/>
        <InternalsVisibleTo Include="RimWorks.RimLogging.Patches.Harmony"/>
    </ItemGroup>

    <ItemGroup>
        <!-- ships to Assemblies/: Directory.Build.props excludes runtime assets by default -->
        <PackageReference Include="System.Text.Json" Version="8.0.5" ExcludeAssets=""/>
        <PackageReference Include="Concord.Ref" Version="0.16.0" PrivateAssets="all"/>
        <PackageReference Include="Concord.Analyzers" Version="0.16.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <Reference Include="..\..\..\RimWorldWin64_Data\Managed\*.dll" Condition="Exists('..\..\..\RimWorldWin64_Data\Managed')">
            <Private>False</Private>
        </Reference>
        <Reference Include="C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed\*.dll" Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed')">
            <Private>False</Private>
        </Reference>
        <Reference Include="/mnt/games/SteamLibrary/steamapps/common/RimWorld/RimWorldLinux_Data/Managed/*.dll" Condition="Exists('/mnt/games/SteamLibrary/steamapps/common/RimWorld/RimWorldLinux_Data/Managed')">
            <Private>False</Private>
        </Reference>
        <Reference Include="/mnt/games/RimWorld/RimWorldLinux_Data/Managed/*.dll" Condition="Exists('/mnt/games/RimWorld/RimWorldLinux_Data/Managed')">
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="'$(HasLocalRimWorld)' == 'false'">
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="Languages/**/*.xml" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- Inner builds only; the multi-target outer build has no ResolveAssemblyReferences. -->
    <Target Name="CopyRimWorldRuntimeDeps" AfterTargets="Build" DependsOnTargets="ResolveAssemblyReferences" Condition="'$(TargetFramework)' != ''">
        <Copy SourceFiles="@(ReferenceCopyLocalPaths)"
              DestinationFiles="@(ReferenceCopyLocalPaths->'$(OutDir)%(DestinationSubDirectory)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>
